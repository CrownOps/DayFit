# App
SECRET_KEY=change-me-to-a-random-secret
ENCRYPTION_KEY=change-me-32byte-urlsafe-base64-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_INVITE_BOOTSTRAP_EMAIL=

# Database
DATABASE_URL=postgresql+psycopg://dayfit:dayfit@localhost:5432/dayfit

# Google OAuth (Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback

# Web Push (self VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:eunji7480@gachon.ac.kr

# Claude (Anthropic).
#  - GCS Pulse의 AI 제안/채점이 실패하면 자체 Claude 호출로 폴백한다.
#  - 이메일 AI 요약/할 일 추출은 이 키가 있어야만 동작한다(상류 경로 없음).
# 비워 두면 폴백은 꺼지고, 이메일 요약은 "설정되어 있지 않다"고 안내한다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# GCS Pulse
GCS_PULSE_BASE_URL=https://api.1000.school
GCS_PULSE_TEAM_ID=78I8M9OE

# Frontend origin. Used for OAuth redirects AND automatically allowed for CORS,
# so in production set this to the real frontend URL (no trailing slash).
FRONTEND_URL=http://localhost:3000

# Extra CORS origins beyond FRONTEND_URL (comma-separated). Optional — any
# localhost/127.0.0.1 port is already allowed for local dev.
CORS_ORIGINS=http://localhost:3000
