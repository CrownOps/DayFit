# Production env for docker-compose.prod.yml.
# On the VM: copy this to `.env` (repo root, same dir as docker-compose.prod.yml)
# — `cp deploy/env.prod.example .env` — and fill in real values.
# Never commit the filled-in `.env`.

DOMAIN=dentalsyncs.com

# DB
POSTGRES_PASSWORD=change-me-strong-random

# App
SECRET_KEY=change-me-to-a-random-secret
ENCRYPTION_KEY=change-me-32byte-urlsafe-base64-fernet-key
ADMIN_INVITE_BOOTSTRAP_EMAIL=

# Web Push (self VAPID) — reuse the local .env values so existing push
# subscriptions stay valid.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:eunji7480@gachon.ac.kr

# GCS Pulse
GCS_PULSE_TEAM_ID=78I8M9OE
